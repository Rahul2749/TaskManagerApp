@* Components/Pages/Login.razor *@
@page "/login"
@layout TaskManager.Client.Components.Layout.LoginLayout
@using TaskManager.Client.Components
@using TaskManager.Client.Components.Layout
@using TaskManager.Shared.DTOs
@using TaskManager.Client.Services
@inject IAuthServiceClient AuthService
@inject NavigationManager Navigation
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<div class="login-split-layout">
    <div class="login-visuals">
        <div class="visuals-content">
            <div class="brand-logo-light">
                <MudIcon Icon="@Icons.Material.Filled.Assignment" Class="brand-icon" />
                <span class="brand-text">TaskManager</span>
            </div>

            <h1 class="visuals-headline">
                Organize your work.<br />
                <span class="highlight-text">Find your focus.</span>
            </h1>

            <p class="visuals-subheadline">
                The soft modern workspace for teams that value clarity and calm over chaos.
            </p>

            <div class="abstract-shapes">
                <div class="shape shape-1"></div>
                <div class="shape shape-2"></div>
                <div class="shape shape-3"></div>
            </div>
        </div>
    </div>

    <div class="login-form-side">
        <div class="login-form-container">
            <div class="mobile-brand">
                <MudIcon Icon="@Icons.Material.Filled.Assignment" Class="brand-icon" />
                <span class="brand-text">TaskManager</span>
            </div>

            <MudText Typo="Typo.h4" Class="mb-1">Welcome back</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">
                Please enter your details to sign in.
            </MudText>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">@errorMessage</MudAlert>
            }

            @if (_twoFactorChallenge is null)
            {
            <EditForm Model="loginModel" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <MudTextField @bind-Value="loginModel.Username"
                              Label="Username"
                              Variant="Variant.Outlined"
                              Placeholder="Enter your username"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Person"
                              Class="mb-4"
                              For="@(() => loginModel.Username)"
                              autocomplete="username" />

                <MudTextField @bind-Value="loginModel.Password"
                              Label="Password"
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              Placeholder="••••••••"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Lock"
                              Class="mb-4"
                              For="@(() => loginModel.Password)"
                              autocomplete="current-password" />

                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                    <MudCheckBox @bind-Value="rememberMe" Label="Remember me" Color="Color.Primary" />
                    <MudLink Href="/forgot-password" Typo="Typo.body2">Forgot password?</MudLink>
                </MudStack>

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Disabled="isLoading"
                           EndIcon="@Icons.Material.Filled.ArrowForward">
                    @if (isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Signing in...</span>
                    }
                    else
                    {
                        <span>Sign in to workspace</span>
                    }
                </MudButton>
            </EditForm>

            <MudDivider Class="my-6" />
            <MudText Typo="Typo.subtitle2" Class="mb-2">Sign in with SSO</MudText>
            <div class="sso-form-row">
                <MudTextField @bind-Value="_ssoSlug" Label="Workspace slug" Variant="Variant.Outlined" Dense="true" Margin="Margin.None"
                              Class="sso-slug-field" />
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="StartSso"
                           Class="sso-continue-button">Continue</MudButton>
            </div>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="sso-helper-text">
                From your workspace URL or settings
            </MudText>

            <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mt-6">
                Don't have an account?
                <MudLink Href="/register" Typo="Typo.body2">Sign up for free</MudLink>
            </MudText>
            }
            else
            {
                <MudText Typo="Typo.h6" Class="mb-2">Verify it’s you</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                    Enter the six-digit code sent to your account email. You can also use a recovery code.
                </MudText>
                <MudTextField @bind-Value="_twoFactorCode" Label="Verification code" Variant="Variant.Outlined"
                              InputMode="InputMode.numeric" MaxLength="32" autocomplete="one-time-code" Class="mb-4" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large"
                           Disabled="isLoading" OnClick="VerifyLoginTwoFactorAsync">
                    @(isLoading ? "Verifying..." : "Verify and sign in")
                </MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" Class="mt-2"
                           Disabled="isLoading" OnClick="CancelTwoFactor">Back to sign in</MudButton>
            }
        </div>
    </div>
</div>

<style>
    .login-split-layout {
        display: flex;
        min-height: 100vh;
        width: 100%;
        background-color: var(--bg-main);
    }

    .login-visuals {
        flex: 1;
        background: linear-gradient(135deg, var(--bg-sidebar), var(--bg-main));
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 4rem;
        border-right: 1px solid var(--border-color);
    }

    .visuals-content {
        position: relative;
        z-index: 2;
        max-width: 600px;
    }

    .brand-logo-light {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 4rem;
        color: var(--primary-navy);
    }

    .brand-icon {
        font-size: 2.5rem;
        color: var(--accent-purple);
    }

    .brand-text {
        font-size: 1.75rem;
        font-weight: 800;
        letter-spacing: -0.02em;
    }

    .visuals-headline {
        font-size: 3.5rem;
        font-weight: 800;
        line-height: 1.1;
        color: var(--primary-navy);
        margin-bottom: 1.5rem;
        letter-spacing: -0.02em;
    }

    .highlight-text {
        color: var(--accent-purple);
    }

    .visuals-subheadline {
        font-size: 1.25rem;
        color: var(--text-secondary);
        line-height: 1.6;
        max-width: 480px;
    }

    .abstract-shapes {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 1;
        pointer-events: none;
    }

    .shape {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        opacity: 0.5;
        animation: float 20s infinite ease-in-out;
    }

    .shape-1 {
        background: var(--accent-purple);
        width: 400px;
        height: 400px;
        top: -100px;
        right: -100px;
    }

    .shape-2 {
        background: var(--accent-calm);
        width: 500px;
        height: 500px;
        bottom: -200px;
        left: -100px;
        animation-delay: 2s;
    }

    .shape-3 {
        background: var(--accent-warm);
        width: 300px;
        height: 300px;
        top: 40%;
        right: 10%;
        animation-delay: 5s;
    }

    @@keyframes float {
        0%, 100% { transform: translate(0, 0) scale(1); }
        33% { transform: translate(30px, -50px) scale(1.1); }
        66% { transform: translate(-20px, 20px) scale(0.9); }
    }

    .login-form-side {
        width: 100%;
        max-width: 600px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg-card);
        position: relative;
    }

    .login-form-container {
        width: 100%;
        max-width: 420px;
        padding: 2.5rem;
    }

    .sso-form-row {
        display: flex;
        align-items: flex-start;
        gap: 0.625rem;
    }

    .sso-slug-field {
        flex: 1 1 auto;
        min-width: 0;
        margin: 0 !important;
    }

    .sso-continue-button {
        flex: 0 0 7.5rem;
        height: 40px;
        min-height: 40px;
        margin-top: 0;
    }

    .sso-helper-text {
        display: block;
        margin: 0.25rem 0 0 0.625rem;
    }

    .mobile-brand {
        display: none;
        align-items: center;
        gap: 10px;
        margin-bottom: 3rem;
        color: var(--primary-navy);
        justify-content: center;
    }

    @@media (max-width: 900px) {
        .login-visuals { display: none; }
        .login-form-side { max-width: 100%; background: var(--bg-main); }
        .login-form-container {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-card);
            padding: 3rem 2rem;
            margin: 2rem;
        }
        .mobile-brand { display: flex; }
        .brand-icon { font-size: 2rem; }
        .brand-text { font-size: 1.5rem; }
    }

    @@media (max-width: 480px) {
        .login-form-container { padding: 2rem 1.5rem; margin: 1rem; }
        .sso-form-row { flex-direction: column; }
        .sso-slug-field,
        .sso-continue-button { width: 100%; }
        .sso-continue-button { flex-basis: auto; }
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "ssoError")]
    public string? SsoError { get; set; }

    private LoginDto loginModel = new();
    private bool isLoading = false;
    private bool rememberMe = false;
    private string errorMessage = string.Empty;
    private string _ssoSlug = "";
    private string? _twoFactorChallenge;
    private string _twoFactorCode = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(SsoError))
            errorMessage = Uri.UnescapeDataString(SsoError);
        if (string.Equals(GetQueryParam("twoFactor"), "1", StringComparison.Ordinal))
            _twoFactorChallenge = await AuthService.GetPendingLoginChallengeAsync();
    }

    private void StartSso()
    {
        if (string.IsNullOrWhiteSpace(_ssoSlug))
        {
            errorMessage = "Enter your workspace slug to continue with SSO.";
            return;
        }

        var slug = Uri.EscapeDataString(_ssoSlug.Trim().ToLowerInvariant());
        Navigation.NavigateTo($"/api/sso/{slug}/start", forceLoad: true);
    }

    private async Task HandleLogin()
    {
        if (isLoading) return;
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var result = await AuthService.LoginAsync(loginModel);

            if (result?.RequiresTwoFactor == true && !string.IsNullOrWhiteSpace(result.ChallengeToken))
            {
                _twoFactorChallenge = result.ChallengeToken;
                await AuthService.SetPendingLoginChallengeAsync(_twoFactorChallenge);
                return;
            }

            if (result?.Tokens is not null)
            {
                await NavigateAfterLoginAsync(result.Tokens.User);
            }
            else
            {
                errorMessage = "Invalid username or password. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred. Please try again later.";
            Console.WriteLine($"Login error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task VerifyLoginTwoFactorAsync()
    {
        if (string.IsNullOrWhiteSpace(_twoFactorChallenge)) return;
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            if (!await AuthService.VerifyLoginTwoFactorAsync(_twoFactorChallenge, _twoFactorCode))
            {
                errorMessage = "The code is invalid or expired. Check it and try again.";
                return;
            }
            await NavigateAfterLoginAsync();
        }
        finally { isLoading = false; }
    }

    private async Task NavigateAfterLoginAsync(UserDto? signedInUser = null)
    {
        var user = signedInUser ?? await AuthService.GetCurrentUserAsync();
        if (user is null)
        {
            errorMessage = "Sign-in completed, but your session could not be loaded. Please try again.";
            return;
        }
        var defaultRoute = user.Role switch
        {
            "SuperAdmin" => "/superadmin/dashboard",
            "OrganizationAdmin" => user.NeedsOnboarding ? "/onboarding" : "/admin/dashboard",
            "Manager" => "/manager/dashboard",
            "User" => "/user/dashboard",
            _ => "/"
        };
        Navigation.NavigateTo(IsSafeLocalReturnUrl(ReturnUrl) ? ReturnUrl! : defaultRoute, replace: true);
    }

    private async Task CancelTwoFactor()
    {
        _twoFactorChallenge = null;
        _twoFactorCode = string.Empty;
        errorMessage = string.Empty;
        await AuthService.ClearPendingLoginChallengeAsync();
    }

    private string? GetQueryParam(string key)
    {
        var query = new Uri(Navigation.Uri).Query.TrimStart('?');
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = part.Split('=', 2);
            if (pair.Length == 2 && string.Equals(Uri.UnescapeDataString(pair[0]), key, StringComparison.OrdinalIgnoreCase))
                return Uri.UnescapeDataString(pair[1]);
        }
        return null;
    }

    private static bool IsSafeLocalReturnUrl(string? returnUrl)
    {
        if (string.IsNullOrWhiteSpace(returnUrl) || !returnUrl.StartsWith('/')
            || returnUrl.StartsWith("//") || returnUrl.StartsWith("/\\")) return false;
        var path = Uri.UnescapeDataString(returnUrl.Split('?', '#')[0]).TrimEnd('/');
        // Authentication pages cannot be the destination of a successful sign-in.
        return !new[] { "/login", "/register", "/forgot-password", "/reset-password", "/sso-callback" }
            .Contains(path, StringComparer.OrdinalIgnoreCase)
            && !path.StartsWith("/api/", StringComparison.OrdinalIgnoreCase);
    }
}
