# Copy to .env on the server. Never commit the real .env file.
GHCR_IMAGE=ghcr.io/REPLACE_WITH_LOWERCASE_GITHUB_OWNER/taskmanager-app
IMAGE_TAG=latest
DOMAIN=tasks.example.com

# PostgreSQL credentials. Use a generated, URL/connection-string-safe password (hex is safe).
POSTGRES_DB=taskmanager
POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS

# Required application secrets and initial administrator.
JWT_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_PASSWORD=ReplaceWithStrongPassword123
SEED_SUPERADMIN_USERNAME=superadmin
DATABASE_INITIALIZE_ON_STARTUP=true
SEED_CREATE_SUPERADMIN=true
SEED_DEMO_DATA=false

# Optional integrations. Leave blank until configured with the provider.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Resend transactional email. Verify the sender domain in Resend before production use.
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=TaskManager
